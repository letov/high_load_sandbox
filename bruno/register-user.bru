meta {
  name: Register user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "login": "ivan",
    "password": "secret123",
    "first_name": "Ivan",
    "last_name": "Ivanov",
    "birth_date": "1990-01-01",
    "gender": "male",
    "interests": "go, chess",
    "city": "Moscow"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("userId", res.body.id);
  }
}
